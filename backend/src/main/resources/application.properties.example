spring.datasource.url=jdbc:mysql://localhost:3306/
spring.datasource.username=${DB_USERNAME:dien_user_vào_file_env}
spring.datasource.password=${DB_PASSWORD:dien_pass_vào_file_env}

spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
debug=true
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl

spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USER:dien_email_vào_file_env}
spring.mail.password=${MAIL_PASS:dien_app_password_vào_file_env}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
server.tomcat.max-http-form-post-size=10MB

vnpay.tmn-code=${VNPAY_TMN_CODE}
vnpay.hash-secret=${VNPAY_HASH_SECRET}
vnpay.return-url=${VNPAY_RETURN_URL}
vnpay.url=${VNPAY_URL}
vnpay.ipn-url=${VNPAY_IPN_URL}